# Copy this file to "keystore.properties" (same folder) and fill in your real values.
# keystore.properties is git-ignored, so your signing secrets never get committed.
#
# To generate a release keystore (one-time, run from a terminal):
#   keytool -genkey -v -keystore womensafety-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias womensafety

storeFile=../womensafety-release.jks
storePassword=CHANGE_ME
keyAlias=womensafety
keyPassword=CHANGE_ME
