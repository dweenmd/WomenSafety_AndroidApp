<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.WomenSafety" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/primary</item> <!-- E63950 looks good on dark too -->
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        
        <!-- Dark backgrounds -->
        <item name="android:colorBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        
        <!-- Light text for dark mode -->
        <item name="colorOnSurface">#EAE8EE</item>
        <item name="colorOnSurfaceVariant">#A09EA4</item>
        
        <item name="colorError">@color/sos</item>
        <item name="colorOnError">#FFFFFF</item>
        
        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.WomenSafety.AppTitle</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.WomenSafety.ScreenTitle</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.WomenSafety.CardTitle</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.WomenSafety.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.WomenSafety.Caption</item>
    </style>

    <style name="Theme.WomenSafety" parent="Base.Theme.WomenSafety" />
</resources>