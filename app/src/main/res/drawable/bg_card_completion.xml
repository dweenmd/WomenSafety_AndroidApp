<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background: the 4dp left border color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/premium_login_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Overlay background: slightly inset from the left to reveal the border -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/premium_login_input_bg" />
            <corners
                android:topRightRadius="12dp"
                android:bottomRightRadius="12dp" />
        </shape>
    </item>
</layer-list>
