<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Legacy styles (keep temporarily) -->
    <style name="NeonButton" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#00FF00</item>
        <item name="android:shadowColor">#00FF00</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- Phase 2: Typography (Roboto is default sans-serif in Android) -->
    <style name="TextAppearance.WomenSafety.AppTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.WomenSafety.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item> <!-- No semibold in standard sans-serif before Android 9, bold is fallback -->
        <item name="android:textFontWeight">600</item> <!-- SemiBold for API 28+ -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.WomenSafety.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">500</item> <!-- Medium for API 28+ -->
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.WomenSafety.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.WomenSafety.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Phase 2: Card Style -->
    <style name="Widget.WomenSafety.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
    </style>
</resources>
