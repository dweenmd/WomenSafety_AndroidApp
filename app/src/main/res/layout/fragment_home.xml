<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_login_bg"
    tools:context=".ui.home.HomeFragment">

    <!-- Status Header Card (Top) -->
    <FrameLayout
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_premium_input_normal"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_secure"
                android:contentDescription="@string/cd_status_icon"
                app:tint="@color/status_safe" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_protection_active"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_battery_checking"
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_protection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Pulse Animation Background Views -->
    <View
        android:id="@+id/pulse_bg_2"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/pulse_circle"
        android:alpha="0.3"
        android:visibility="invisible"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/layout_quick_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_status" />

    <View
        android:id="@+id/pulse_bg_1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/pulse_circle"
        android:alpha="0.5"
        android:visibility="invisible"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/layout_quick_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_contact_summary" />

    <!-- Contact Summary Row -->
    <LinearLayout
        android:id="@+id/layout_contact_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/card_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_contacts"
            android:contentDescription="@string/cd_contacts_icon"
            app:tint="@color/premium_login_text_secondary" />

        <TextView
            android:id="@+id/tv_contact_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/home_contacts_added"
            android:textColor="@color/premium_login_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_manage_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/home_manage_contacts"
            android:textColor="@color/premium_login_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Main SOS Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sos"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:backgroundTint="?attr/colorError"
        android:contentDescription="@string/cd_sos_button"
        android:text="@string/home_btn_sos"
        android:textColor="?attr/colorOnError"
        android:textSize="24sp"
        android:textStyle="bold"
        app:cornerRadius="100dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_quick_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_contact_summary" />

    <!-- Quick Actions (Bottom) -->
    <LinearLayout
        android:id="@+id/layout_quick_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="16dp">
            
            <ImageButton
                android:id="@+id/btn_quick_fake_call"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/circle_bg_secondary"
                android:src="@android:drawable/stat_sys_phone_call"
                android:contentDescription="@string/cd_fake_call"
                app:tint="?attr/colorPrimary" />
                
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_quick_fake_call"
                android:textColor="@color/premium_login_text_main"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="16dp">
            
            <ImageButton
                android:id="@+id/btn_quick_record"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/circle_bg_secondary"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="@string/cd_record"
                app:tint="?attr/colorPrimary" />
                
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_quick_record"
                android:textColor="@color/premium_login_text_main"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="16dp">
            
            <ImageButton
                android:id="@+id/btn_quick_share_location"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/circle_bg_secondary"
                android:src="@android:drawable/ic_menu_mylocation"
                android:contentDescription="@string/cd_live_link"
                app:tint="?attr/colorPrimary" />
                
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_quick_live_link"
                android:textColor="@color/premium_login_text_main"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
