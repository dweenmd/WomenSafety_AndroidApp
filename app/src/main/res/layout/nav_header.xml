<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:background="@color/m3_surface_container_low">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/drawer_avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_person"
        android:background="@color/m3_surface_container_lowest"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
        app:strokeWidth="2dp"
        app:strokeColor="@color/m3_surface_container_lowest"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/drawer_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alex Johnson"
        android:textColor="@color/m3_on_surface"
        android:textSize="22sp"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/drawer_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="alex.johnson@example.com"
        android:textColor="@color/m3_on_surface_variant"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/drawer_view_profile"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Profile"
        android:textColor="@color/m3_primary_container"
        android:textSize="14sp"
        android:fontFamily="@font/inter"
        app:strokeColor="@android:color/transparent"
        android:layout_marginLeft="-16dp"
        android:layout_marginBottom="24dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="-24dp"
        android:layout_marginEnd="-24dp"
        android:background="@color/m3_outline_variant" />

</LinearLayout>
