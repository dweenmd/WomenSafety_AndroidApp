<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_login_bg"
    tools:context=".ui.profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textColor="@color/premium_login_text_main"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Header Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_premium_input_normal"
            android:padding="20dp"
            android:layout_marginBottom="32dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <ImageView
                    android:id="@+id/iv_profile_avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_person"
                    android:background="@drawable/pulse_circle"
                    android:padding="12dp"
                    app:tint="@color/premium_login_text_main" />
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Dween Mohammad"
                        android:textColor="@color/premium_login_text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                        
                    <TextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="dween.gk@gmail.com"
                        android:textColor="@color/premium_login_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                        
                    <TextView
                        android:id="@+id/btn_edit_profile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Edit Profile"
                        android:textColor="@color/premium_login_primary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ACCOUNT Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT"
            android:textColor="@color/premium_login_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp" />
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_premium_input_normal"
            android:layout_marginBottom="24dp">
            
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_personal_info" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_security" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_privacy" />
        </LinearLayout>

        <!-- SAFETY Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAFETY"
            android:textColor="@color/premium_login_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp" />
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_premium_input_normal"
            android:layout_marginBottom="24dp">
            
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_emergency_contacts" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_sos_settings" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_location" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_safety_notifications" />
        </LinearLayout>
        
        <!-- APP Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP"
            android:textColor="@color/premium_login_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp" />
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_premium_input_normal"
            android:layout_marginBottom="32dp">
            
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_notifications" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_appearance" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_language" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_help" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/premium_login_input_bg" android:layout_marginHorizontal="16dp"/>
            <include layout="@layout/item_profile_menu" android:id="@+id/menu_about" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Sign Out"
            android:textColor="?attr/colorError"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
