<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_login_bg"
    tools:context=".ui.safety.SafetyFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety Settings"
            android:textColor="@color/premium_login_text_main"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_premium_input_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Background Protection -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_background_protection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Background Protection"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep the app running in the background to listen for triggers."
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Live Location on SOS -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_live_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Include Live Location"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send your current Google Maps link when SOS is triggered."
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Shake Detection -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_shake_detection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shake to SOS"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trigger SOS by violently shaking your phone."
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Auto Notify Low Battery -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_notify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Low Battery Warning"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notify contacts when your battery drops below 15%."
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Silent SOS Mode -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_silent_sos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Silent SOS Mode"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trigger SOS without vibrating or making a sound."
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Bangla Language Toggle -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="বাংলা ভাষা (Bangla)"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Switch app language to Bengali (Requires Restart)."
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>
