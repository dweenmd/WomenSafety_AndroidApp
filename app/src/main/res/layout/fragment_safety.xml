<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_login_bg"
    tools:context=".ui.safety.SafetyFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/safety_title"
            android:textColor="@color/premium_login_text_main"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_premium_input_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Background Protection -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_background_protection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_bg_protection"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_bg_protection_desc"
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Live Location on SOS -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_live_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_live_location"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_live_location_desc"
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Shake Detection -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_shake_detection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_shake_sos"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_shake_sos_desc"
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Auto Notify Low Battery -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_notify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_low_battery"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_low_battery_desc"
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Silent SOS Mode -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_silent_sos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_silent_sos"
                    android:textColor="@color/premium_login_text_main"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/safety_silent_sos_desc"
                    android:textColor="@color/premium_login_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>
