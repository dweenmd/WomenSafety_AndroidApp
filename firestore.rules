rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles, contacts and settings: private to the owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Live-location tracking sessions. Session ids are 20-char random hex
    // (unguessable), so anyone holding the link may follow until it expires;
    // only the owner app can create/update their session.
    match /live_sessions/{sessionId} {
      allow read: if request.time < resource.data.expiresAt;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }
  }
}
